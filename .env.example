# TRIAGE environment template — local Ollama for both generation and judging.
#
# Generator: llama3.1:8b (CPU-only on Kaggle to reserve the T4).
# Judge:     phi4:14b (Ollama on the Kaggle T4).
#
# Prerequisites:
#   ollama pull llama3.1:8b
#   ollama pull phi4:14b
#
LLM_PROVIDER=ollama
JUDGE_PROVIDER=ollama
JUDGE_OLLAMA_MODEL=phi4:14b

# Optional unrelated integrations:
# WANDB_API_KEY=...
# WANDB_MODE=disabled
# TYPESAFE_API_KEY=...
# NVIDIA_API_KEY=...
# HF_TOKEN=...  # still used for embedding/model downloads where required
